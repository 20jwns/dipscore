# 토스증권 오픈API 연동 - 로컬 개발용 환경변수
#
# 사용법:  cp .env.example .env  후 실제 값 채우기
# .env 는 .gitignore 로 커밋 제외됨. 실제 자격증명을 이 파일(.env.example)에 넣지 말 것.
#
# ⚠️ client_id/secret 을 넣어도 토큰 발급이 403(IP address not allowed)으로 실패한다면
#    자격증명 문제가 아니라 IP 허용 목록 미등록 문제다.
#    토스증권 WTS 로그인 > 설정 > Open API > 허용 IP 관리 에서 현재 발신 IP 를 등록할 것.

# --- 필수: 발급받은 앱 자격증명 (토스증권 WTS 설정 > Open API 에서 발급) ---
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=

# --- 필수: DART 전자공시 오픈API 인증키 (https://opendart.fss.or.kr 가입 후 발급, 40자리) ---
DART_API_KEY=

# --- 필수: 한국은행 ECOS 오픈API 인증키 (https://ecos.bok.or.kr/api 가입 후 발급) ---
ECOS_API_KEY=

# --- 선택: 엔드포인트 (미설정 시 application.yml 기본값 사용) ---
# TOSS_API_BASE_URL=https://openapi.tossinvest.com
# TOSS_AUTH_BASE_URL=https://openapi.tossinvest.com
# TOSS_AUTH_TOKEN_PATH=/oauth2/token
# TOSS_AUTH_GRANT_TYPE=client_credentials
# TOSS_AUTH_SCOPE=
# TOSS_QUOTE_PRICE_PATH=/api/v1/prices

# --- 선택: 타임아웃 / 토큰 갱신 여유시간 (Duration 표기: 3s, 500ms, 1m) ---
# TOSS_API_CONNECT_TIMEOUT=3s
# TOSS_API_READ_TIMEOUT=5s
# TOSS_AUTH_REFRESH_SKEW=60s

# --- 선택: DART 엔드포인트/타임아웃 (미설정 시 application.yml 기본값) ---
# DART_API_BASE_URL=https://opendart.fss.or.kr
# DART_API_READ_TIMEOUT=10s
# DART_API_COMPANY_PATH=/api/company.json
# DART_API_FINANCIALS_PATH=/api/fnlttSinglAcntAll.json
# DART_API_CORP_CODE_PATH=/api/corpCode.xml
# DART_API_STOCK_TOTAL_PATH=/api/stockTotqySttus.json

# --- 선택: ECOS 엔드포인트/언어/타임아웃 (미설정 시 application.yml 기본값) ---
# ECOS_API_BASE_URL=https://ecos.bok.or.kr
# ECOS_API_LANGUAGE=kr
# ECOS_API_READ_TIMEOUT=10s

# --- 선택: 시세 적재 스케줄러 (미설정 시 application.yml 기본값: 활성/삼성전자/60초) ---
# PRICE_INGESTION_ENABLED=true
# PRICE_INGESTION_SYMBOLS=005930,000660
# PRICE_INGESTION_INTERVAL_MS=60000
# PRICE_INGESTION_INITIAL_DELAY_MS=10000

# --- 선택: 과거 시세 백필 (수동 트리거 POST /api/admin/price-backfill, 자동 실행 안 함) ---
# BACKFILL_PRICES_SYMBOLS=005930,000660,042700
# BACKFILL_PRICES_DAYS=365
# BACKFILL_PRICES_DELAY_MS=300

# --- 선택: 일별 배치 (대상 종목은 DAILY_BATCH_SYMBOLS 공유) ---
# DAILY_BATCH_SYMBOLS=005930,000660,042700   # 모든 일별/주간 배치가 공유하는 대상 종목
#   장 마감 후 최신 일봉 적재 (POST /api/admin/daily-candle-sync)
# DAILY_CANDLE_SYNC_ENABLED=true
# DAILY_CANDLE_SYNC_CRON=0 0 16 * * MON-FRI   # Asia/Seoul (평일 16:00)
#   장 시작 전 매력도 → 저점진입 스코어 계산 (POST /api/admin/daily-scoring)
# DAILY_SCORING_ENABLED=true                  # attractiveness.enabled + entry-score.enabled 도 true 여야 동작
# DAILY_SCORING_CRON=0 30 8 * * MON-FRI       # Asia/Seoul (평일 08:30)

# --- 선택: 주간 재무제표 적재 스케줄러 (DART → financial_snapshot) + POST /api/admin/financial-snapshot-sync ---
# FINANCIAL_SNAPSHOT_SYNC_ENABLED=true          # attractiveness.enabled 도 true 여야 동작
# FINANCIAL_SNAPSHOT_SYNC_CRON=0 0 3 * * MON     # Asia/Seoul (매주 월 03:00)
# FINANCIAL_SNAPSHOT_SYNC_FISCAL_YEAR=0          # 0 = 자동(작년)
# FINANCIAL_SNAPSHOT_SYNC_DELAY_MS=300

# --- 선택: 거시지표(ECOS) 자동 갱신 스케줄러 (→ macro_indicator) + POST /api/admin/macro-sync ---
# MACRO_SYNC_ENABLED=true                        # attractiveness.enabled 도 true 여야 동작
# MACRO_SYNC_FX_CRON=0 0 6 * * *                 # 환율: 매일 06:00 Asia/Seoul
# MACRO_SYNC_MONTHLY_CRON=0 0 6 1 * *            # 기준금리·CPI: 매월 1일 06:00 Asia/Seoul

# --- 선택: 저점 진입 스코어 엔진 (application.yml 기본값 활성) ---
# ENTRY_SCORE_ENABLED=true

# --- 선택: 매매 신호 판정 (application.yml 기본값 활성) ---
# SIGNAL_ENABLED=true

# --- 선택: 가상 계좌/포지션 (모의투자 매수·매도 체결) — signal.enabled 도 true 여야 체결 관련 빈이 뜸 ---
# ACCOUNT_ENABLED=true
# ACCOUNT_INITIAL_CAPITAL=10000000        # POST /api/account/init 기본 초기자금(원)
# ACCOUNT_MIN_INITIAL_CAPITAL=100000      # 계좌 개설 최소 초기자금 — 미달이면 거부
# ACCOUNT_MIN_BUY_UNIT=100000             # 최소매수단위
# ACCOUNT_RISK_PER_TRADE_PCT=0.01         # 변동성 기반 사이징: 거래당 리스크 허용 비율(잔고 대비, 기본 1%)

# --- 선택: 종목 마스터 동기화 (매일 자동 InstrumentSyncJob + 수동 POST /api/admin/instrument-sync) ---
# INSTRUMENT_SYNC_SCHEDULED=true            # false → 스케줄러만 끔 (수동 엔드포인트는 유지)
# INSTRUMENT_SYNC_CRON=0 0 4 * * *          # Asia/Seoul, 매일 04:00
# INSTRUMENT_SYNC_CHUNK_SIZE=500
# INSTRUMENT_SYNC_FILTER_CORP_CLS=true      # 코넥스(N) → active=false soft-delete. 종목별 기업개황 조회 (수십 분 소요)
# INSTRUMENT_SYNC_DETECT_DELISTINGS=true    # DART 목록에서 사라진 활성 KR_STOCK → 유예 후 active=false
# INSTRUMENT_SYNC_STALE_DAYS=3              # 상장폐지 판정 유예일 (DART 일시 조회 실패 오탐 방지)
# INSTRUMENT_SYNC_COMPANY_DELAY_MS=100
# INSTRUMENT_SYNC_MAX_FAILURES=20
